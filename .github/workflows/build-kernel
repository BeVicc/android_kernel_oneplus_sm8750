name: Build OnePlus Ace 6 SUSfs Kernel

on:
  workflow_dispatch:
    inputs:
      kernel_branch:
        description: "Kernel source branch"
        required: true
        default: "main"
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Free up disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo docker image prune --all --force 2>/dev/null || true
          sudo apt-get clean
          df -h

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            bc bison build-essential flex \
            g++-multilib gcc-multilib git \
            libelf-dev libssl-dev \
            make python3 zip unzip wget \
            lz4 binutils-aarch64-linux-gnu \
            gcc-aarch64-linux-gnu \
            gcc-arm-linux-gnueabi

      - name: Set up Clang 21
        run: |
          mkdir -p $GITHUB_WORKSPACE/clang
          wget -q \
            https://github.com/ZyCromerZ/Clang/releases/download/21.0.0-20250101-release/Clang-21.0.0-20250101.tar.gz \
            -O clang.tar.gz
          tar -xzf clang.tar.gz -C $GITHUB_WORKSPACE/clang
          echo "$GITHUB_WORKSPACE/clang/bin" >> $GITHUB_PATH
          clang --version

      - name: Clone kernel source
        run: |
          BRANCH="${{ github.event.inputs.kernel_branch }}"
          BRANCH="${BRANCH:-main}"
          git clone --depth=1 \
            --branch "$BRANCH" \
            https://github.com/Ace6-Development/android_kernel_oneplus_sm8750 \
            kernel
          echo "Kernel source cloned - branch: $BRANCH"
          cd kernel && git log --oneline -3

      - name: Integrate SukiSU Ultra + SUSfs
        working-directory: kernel
        run: |
          echo "Patching SukiSU Ultra + SUSfs into kernel..."
          curl -LSs "https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh" | bash -s susfs-main
          echo "Integration complete."

      - name: Find correct defconfig
        working-directory: kernel
        id: defconfig
        run: |
          for cfg in \
            vendor/kalama_GKI_defconfig \
            vendor/sm8750_GKI_defconfig \
            vendor/sun_GKI_defconfig \
            kalama_GKI_defconfig \
            gki_defconfig; do
            if [ -f "arch/arm64/configs/$cfg" ]; then
              echo "Found defconfig: $cfg"
              echo "defconfig=$cfg" >> $GITHUB_OUTPUT
              exit 0
            fi
          done
          echo "defconfig=gki_defconfig" >> $GITHUB_OUTPUT

      - name: Build kernel
        working-directory: kernel
        run: |
          export ARCH=arm64
          export SUBARCH=arm64
          export CC=clang
          export LLVM=1
          export LLVM_IAS=1
          export CROSS_COMPILE=aarch64-linux-gnu-
          export CROSS_COMPILE_ARM32=arm-linux-gnueabi-
          export KBUILD_BUILD_USER=GHActions
          export KBUILD_BUILD_HOST=github

          make O=out ARCH=arm64 ${{ steps.defconfig.outputs.defconfig }}

          make -j$(nproc) O=out ARCH=arm64 \
            CC=clang \
            LLVM=1 \
            LLVM_IAS=1 \
            CROSS_COMPILE=aarch64-linux-gnu- \
            CROSS_COMPILE_ARM32=arm-linux-gnueabi- \
            Image.lz4 dtbs 2>&1 | tee ../build.log

          ls -lh out/arch/arm64/boot/

      - name: Package with AnyKernel3
        run: |
          git clone --depth=1 https://github.com/osm0sis/AnyKernel3 anykernel3
          cp kernel/out/arch/arm64/boot/Image.lz4 anykernel3/
          mkdir -p anykernel3/dtbs
          find kernel/out/arch/arm64/boot/dts -name "*.dtb" -exec cp {} anykernel3/dtbs/ \; 2>/dev/null || true

          cd anykernel3
          sed -i "s/device.name1=.*/device.name1=ktm/" anykernel.sh
          sed -i "s/do.devicecheck=1/do.devicecheck=0/" anykernel.sh
          sed -i "s|kernel.string=.*|kernel.string=Ace6-SUSfs-SukiSU by GHActions|" anykernel.sh

          DATE=$(date +%Y%m%d-%H%M)
          ZIP_NAME="Kernel-Ace6-ktm-SUSfs-${DATE}.zip"
          zip -r9 ../${ZIP_NAME} . -x "*.git*" -x "README.md"

          echo "ZIP_NAME=${ZIP_NAME}" >> $GITHUB_ENV
          ls -lh ../${ZIP_NAME}

      - name: Get kernel version
        id: kver
        run: |
          VER=$(cat kernel/out/include/config/kernel.release 2>/dev/null || echo "unknown")
          echo "version=$VER" >> $GITHUB_OUTPUT

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: kernel-ace6-${{ github.run_number }}
          name: "Ace6 SUSfs Kernel - Build #${{ github.run_number }}"
          body: |
            ## OnePlus Ace 6 (ktm) SUSfs Kernel

            Built automatically by GitHub Actions.

            **Kernel version:** ${{ steps.kver.outputs.version }}
            **Source:** Ace6-Development/android_kernel_oneplus_sm8750
            **Root:** SukiSU Ultra + SUSfs integrated

            ### How to flash
            1. Boot into OrangeFox recovery
            2. Flash the zip
            3. Reboot to system
            4. Verify: `adb shell uname -r` - look for `susfs` in output

            ### After flashing
            - SukiSU Manager: install susfs4ksu module
            - Install Zygisk Next
            - Install PlayIntegrityFork
            - Settings -> InfinityX Suite -> Spoofing -> disable all
            - Clear Google Wallet + Play Services data
            - Tap to pay should work!
          files: |
            ${{ env.ZIP_NAME }}
            build.log
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }
